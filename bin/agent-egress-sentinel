#!/usr/bin/env python3
"""Agent Egress Sentinel v2.6.0 — ZothOS CLI Wrapper.

Routes subcommands (serve, run, stats, status, export, openapi, clear, token, mcp, tui, electron)
to the native zero-dependency Python package and enforces strict exit code 2 on unknown commands.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.request

TOOL_ID = "agent-egress-sentinel"
TOOL_REPO = "agent-egress-sentinel"
TOOL_NAME = "Agent Egress Sentinel"
TOOL_DESC = "Zero-dependency userspace HTTP/HTTPS egress proxy, TLS SNI inspector, SSRF guard & radar."
TOOL_VERSION = "2.6.0"
TOOL_CATEGORY = "Security & Network"
TOOL_PORT = 8095
PROXY_PORT = 8195

# Prefer ~/NullAITech checkout if present, else /opt/agent-egress-sentinel in ZothOS chroot
_CANDIDATES = [
    os.path.expanduser("~/NullAITech/agent-egress-sentinel"),
    "/opt/agent-egress-sentinel",
]
REPO_DIR = next((p for p in _CANDIDATES if os.path.isdir(p)), _CANDIDATES[0])
PKG_DIR = os.path.join(REPO_DIR, "src")
SERVER_SCRIPT = os.path.join(REPO_DIR, "server.py")
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"
PROXY_URL = f"http://127.0.0.1:{PROXY_PORT}"

NATIVE_SUBCOMMANDS = frozenset({
    "serve", "run", "stats", "status", "export", "openapi", "clear", "token", "mcp",
})


def check_daemon_status(port: int = TOOL_PORT):
    try:
        req = urllib.request.Request(
            f"http://127.0.0.1:{port}/health",
            headers={"User-Agent": f"ZothOS-CLI/{TOOL_VERSION}"},
        )
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            if resp.status == 200:
                return True, json.loads(resp.read().decode("utf-8"))
    except Exception:
        pass
    return False, None


def main() -> int:
    args = sys.argv[1:]

    if "--electron" in args or (args and args[0] in ("desktop", "electron")):
        rem = [a for a in args if a not in ("--electron", "desktop", "electron")]
        elec = shutil.which("electron") or "/usr/local/bin/electron"
        return subprocess.run([elec, os.path.join(REPO_DIR, "electron", "main.cjs")] + rem, cwd=REPO_DIR).returncode

    if "--tui" in args or (args and args[0] == "tui"):
        rem = [a for a in args if a not in ("--tui", "tui")]
        tui_bin = shutil.which(f"{TOOL_ID}-tui") or os.path.join(REPO_DIR, "bin", f"{TOOL_ID}-tui")
        return subprocess.run([tui_bin] + rem).returncode

    # Pass through native subcommands to agent_egress_sentinel.cli
    if args and args[0] in NATIVE_SUBCOMMANDS:
        env = os.environ.copy()
        env["PYTHONPATH"] = PKG_DIR + os.pathsep + env.get("PYTHONPATH", "")
        return subprocess.run([sys.executable, "-m", "agent_egress_sentinel.cli"] + args, cwd=REPO_DIR, env=env).returncode

    parser = argparse.ArgumentParser(
        prog="agent-egress-sentinel",
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}",
        epilog=(
            "Subcommands: serve, run, stats, status, export, openapi, clear, token, mcp, tui, electron\n"
            "Example: agent-egress-sentinel export -o agent-traffic.har"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local installation & live :8095 daemon status")
    parser.add_argument("--json", action="store_true", help="Output live telemetry JSON")
    parser.add_argument("--port", type=int, default=TOOL_PORT, help=f"Daemon web port (default: {TOOL_PORT})")
    parser.add_argument("--ui", action="store_true", help="Print local radar URL")
    parser.add_argument("--serve", action="store_true", help="Start radar server (:8095) and proxy (:8195)")

    parsed = parser.parse_args(args)

    port = parsed.port
    local_url = f"http://127.0.0.1:{port}"
    is_running, daemon_data = check_daemon_status(port)

    if parsed.serve:
        if is_running:
            print(f"Agent Egress Sentinel daemon already active on {local_url}")
            return 0
        return subprocess.run([sys.executable, SERVER_SCRIPT, "--web-port", str(port), "--proxy-port", str(PROXY_PORT)]).returncode

    proxy_port = daemon_data.get("proxy_port", PROXY_PORT) if isinstance(daemon_data, dict) else PROXY_PORT
    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "daemon_running": is_running,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": local_url,
        "proxy_endpoint": f"http://127.0.0.1:{proxy_port}",
        "daemon_telemetry": daemon_data,
        "license": "100% Free & Open Access (Zero Paywalls)",
        "attribution": "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return 0
    if parsed.ui:
        print(local_url)
        return 0

    print("=====================================================")
    print(f"  {TOOL_NAME} (v{TOOL_VERSION})")
    print(f"  {TOOL_DESC}")
    print("=====================================================")
    print(f"  Installed:       {'Yes' if info['installed'] else 'No'}")
    print(f"  Radar Server:    {local_url} ({'Running' if is_running else 'Offline'})")
    print(f"  Proxy Tunnel:    http://127.0.0.1:{proxy_port}")
    print(f"  Studio Route:    {STUDIO_URL}")
    print("  License:         100% Free & Open Access (Zero Paywalls)")
    print("  Coffee Tip:      https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X")
    print("  Solana Tip:      GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK")
    print("-----------------------------------------------------")
    print("Usage:")
    print("  agent-egress-sentinel serve --web-port 8095 --proxy-port 8195")
    print("  agent-egress-sentinel --status | --json | --version")
    print("  agent-egress-sentinel token")
    print("  agent-egress-sentinel mcp --port 8095")
    print("  agent-egress-sentinel tui --once")
    print("  agent-egress-sentinel run -- <command...>")
    print("  agent-egress-sentinel export -o agent-traffic.har")
    print("=====================================================")
    return 0


if __name__ == "__main__":
    sys.exit(main())
